{
 "name": "Entrega final - Alertas de error",
 "nodes": [
  {
   "parameters": {},
   "id": "cce7abec-cb3f-4717-bfa4-0e22e54903e6",
   "name": "Cuando falla un workflow",
   "type": "n8n-nodes-base.errorTrigger",
   "typeVersion": 1,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "972238ab-5599-4c4d-b7b0-5f4af09f4e74",
       "leftValue": "={{ ($json.execution?.lastNodeExecuted ?? '').startsWith('Control:') }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "looseTypeValidation": true,
    "options": {}
   },
   "id": "cabd4ba4-727f-417c-9ff9-617e7ac9a2b3",
   "name": "¿Ya lo avisó un control?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    220,
    0
   ]
  },
  {
   "parameters": {},
   "id": "ceef3113-cb2e-4a80-9334-4133936fd05c",
   "name": "Ya avisado: no repetir mail",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    460,
    -100
   ]
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "4ff60b89-5fba-490a-9bf2-99ba7fac0134",
       "name": "workflow",
       "value": "={{ $json.workflow?.name ?? 'Workflow sin nombre' }}",
       "type": "string"
      },
      {
       "id": "09b6dd56-66bb-4744-8939-e462095af4b9",
       "name": "nodo",
       "value": "={{ $json.execution?.lastNodeExecuted ?? $json.trigger?.error?.node?.name ?? 'Trigger' }}",
       "type": "string"
      },
      {
       "id": "43f5e63e-5c83-4027-8dca-4e83a35e58a1",
       "name": "error",
       "value": "={{ String($json.execution?.error?.message ?? $json.trigger?.error?.message ?? 'Sin mensaje').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
       "type": "string"
      },
      {
       "id": "a28c9106-1ae3-413b-9157-cc7bc3db941b",
       "name": "modo",
       "value": "={{ $json.execution?.mode === 'trigger' ? 'Programada (todos los días a las 8)' : ($json.execution?.mode ?? 'desconocido') }}",
       "type": "string"
      },
      {
       "id": "298d07f8-4cb1-4b96-815b-a04af0c5a594",
       "name": "cuando",
       "value": "={{ $now.setZone('America/Argentina/Buenos_Aires').toFormat('dd/MM/yyyy HH:mm') }}",
       "type": "string"
      },
      {
       "id": "24e65492-22e2-4007-b111-e42313ca8e29",
       "name": "link",
       "value": "={{ $json.execution?.url ?? 'http://localhost:5678/workflow/' + ($json.workflow?.id ?? '') + '/executions/' + ($json.execution?.id ?? '') }}",
       "type": "string"
      }
     ]
    },
    "options": {}
   },
   "id": "a5e0aecc-ae84-44d0-8b01-15f8720cf654",
   "name": "Armar mail de error",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    460,
    100
   ]
  },
  {
   "parameters": {
    "sendTo": "TU_MAIL_DE_PRUEBA",
    "subject": "=[Atención al transportista] Error en {{ $json.workflow }} · {{ $json.nodo }}",
    "emailType": "html",
    "message": "=<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222\"><p>Hola,</p><p>El workflow <b>{{ $json.workflow }}</b> terminó con un <b>error que no estaba previsto</b> por los controles.</p><table cellpadding=\"6\" style=\"border-collapse:collapse;border:1px solid #ddd\"><tr><td style=\"background:#f3f3f3\"><b>Nodo que falló</b></td><td>{{ $json.nodo }}</td></tr><tr><td style=\"background:#f3f3f3\"><b>Error</b></td><td>{{ $json.error }}</td></tr><tr><td style=\"background:#f3f3f3\"><b>Ejecución</b></td><td>{{ $json.modo }}</td></tr><tr><td style=\"background:#f3f3f3\"><b>Cuándo</b></td><td>{{ $json.cuando }}</td></tr></table><p>Lo que se haya escrito antes del error quedó en la planilla. Como el flujo no duplica casos, se puede volver a ejecutar sin problema una vez corregido.</p><p><a href=\"{{ $json.link }}\">Ver la ejecución en n8n</a></p></div>",
    "options": {
     "appendAttribution": false
    }
   },
   "id": "31805d10-1536-49e7-bad2-412f6c59707f",
   "name": "Enviar mail de error",
   "type": "n8n-nodes-base.gmail",
   "typeVersion": 2.1,
   "position": [
    680,
    100
   ],
   "webhookId": "5dfa626a-ed22-48aa-9b31-4b73eeb3fa85"
  }
 ],
 "connections": {
  "Cuando falla un workflow": {
   "main": [
    [
     {
      "node": "¿Ya lo avisó un control?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "¿Ya lo avisó un control?": {
   "main": [
    [
     {
