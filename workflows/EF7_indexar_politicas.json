  {
   "id": "38f4ff17-077a-4dc8-bdeb-cd554b84dd0a",
   "name": "Nota 5",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    840,
    -260
   ],
   "parameters": {
    "content": "## 2 · Cortar\nUn fragmento por pregunta. El tema y la pregunta van dentro del texto y también como metadatos. Si salen menos de 5 fragmentos, el formato cambió y se frena.",
    "width": 380,
    "height": 150,
    "color": 4
   }
  },
  {
   "id": "842a6f63-83e8-40ba-bb57-e0b2e6e66288",
   "name": "Cortar por pregunta",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    -20
   ],
   "parameters": {
    "jsCode": "// Corta el documento de políticas por pregunta: cada pregunta con su respuesta es un fragmento (chunk).\n// Se corta por la estructura del documento (## tema, ### pregunta) y no cada N caracteres,\n// para que ningún fragmento mezcle dos temas ni quede una respuesta partida al medio.\nconst md = String($json.body ?? $json.data ?? '');\n// Lote: identifica esta indexación. Al terminar se borran los fragmentos de lotes anteriores.\nconst lote = new Date().toISOString().replace(/\\D/g, '').slice(0, 14);\nconst version = (md.match(/Versión\\s+(\\d+)/i) ?? [])[1] ?? '';\n\nlet tema = '';\nconst fragmentos = [];\nfor (const bloque of md.split(/\\n(?=#{2,3} )/)) {\n  const [titulo, ...resto] = bloque.trim().split('\\n');\n  if (titulo.startsWith('## ')) { tema = titulo.replace(/^##\\s*(\\d+\\.\\s*)?/, '').trim(); continue; }\n  if (!titulo.startsWith('### ')) continue;                 // encabezado y aviso del documento: no se indexan\n  const pregunta = titulo.replace(/^###\\s*/, '').trim();\n  const respuesta = resto.join('\\n').trim();\n  if (!respuesta) continue;\n  fragmentos.push({ json: {\n    // El tema y la pregunta van dentro del texto: así el vector también representa de qué trata el fragmento\n    texto: `Tema: ${tema}\\nPregunta: ${pregunta}\\nRespuesta: ${respuesta}`,\n    tema, pregunta, version, lote, fuente: 'politicas_y_preguntas_frecuentes.md',\n  } });\n}\n// Control: si el documento cambió de formato y no se pudo cortar, se frena ANTES de tocar la base\nif (fragmentos.length < 5) throw new Error(`El documento de políticas dio ${fragmentos.length} fragmentos. Revisar el formato: \"## tema\" y \"### pregunta\".`);\nreturn fragmentos;\n"
   }
  },
  {
   "id": "b99cca9f-87a3-486a-a3be-494df3e477ac",
   "name": "Nota 7",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    1260,
    -260
   ],
   "parameters": {
    "content": "## 3 · Convertir y guardar\nGemini calcula el vector (embedding) de cada fragmento y Supabase lo guarda con pgvector. Los fragmentos nuevos se insertan primero y recién después se borran los del lote anterior: si los embeddings fallan, la base vieja sigue funcionando.",
    "width": 760,
    "height": 150,
    "color": 5
   }
  },
  {
   "id": "4c4c8024-a51d-4e4d-a90f-fb4007e62b0b",
   "name": "Guardar en Supabase (pgvector)",
   "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
   "typeVersion": 1.3,
   "position": [
    1320,
    -20
   ],
   "parameters": {
    "mode": "insert",
    "tableName": {
     "__rl": true,
     "mode": "id",
     "value": "documents"
    },
    "options": {
     "queryName": "match_documents"
    }
   },
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 5000
  },
  {
   "id": "bdea0d98-56bd-4396-91cc-e851c1da359f",
   "name": "Embeddings (Gemini)",
   "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
   "typeVersion": 1,
